# Copy this file to .env and fill in your own values

PORT=5000

# Local MongoDB (default if you have MongoDB installed locally)
MONGO_URI=mongodb://127.0.0.1:27017/uniswap_plus

# OR use a free MongoDB Atlas cluster instead of local Mongo:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/uniswap_plus?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
